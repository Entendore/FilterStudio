<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.camera.view.PreviewView android:id="@+id/preview_view"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#66000000" android:padding="8dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/filter_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:requiresFadingEdge="horizontal"/>
        <com.google.android.material.slider.Slider android:id="@+id/strength_slider"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="1" android:stepSize="0.01" android:value="1"
            android:contentDescription="@string/filter_strength"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/btn_flip" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_rotate" android:contentDescription="@string/flip_camera"/>
            <ImageButton android:id="@+id/btn_shutter" style="@style/ShutterButton"
                android:contentDescription="@string/capture"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
