<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/image_preview" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_margin="8dp" app:layout_constraintDimensionRatio="h,3:4"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <com.example.filterstudio.ui.CompareView android:id="@+id/compare_view"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_preview"
        app:layout_constraintStart_toStartOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <ImageView android:id="@+id/vignette_overlay" android:layout_width="0dp" android:layout_height="0dp"
        android:scaleType="fitXY" android:src="@drawable/vignette_overlay" android:alpha="0"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_preview"
        app:layout_constraintStart_toStartOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <com.example.filterstudio.ui.HistogramView android:id="@+id/histogram"
        android:layout_width="72dp" android:layout_height="40dp" android:layout_margin="6dp"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <com.example.filterstudio.ui.OverlayView android:id="@+id/overlay_view"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_preview"
        app:layout_constraintStart_toStartOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <com.example.filterstudio.ui.CropOverlayView android:id="@+id/crop_overlay"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_preview"
        app:layout_constraintStart_toStartOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <com.example.filterstudio.ui.MaskPaintView android:id="@+id/mask_paint"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/image_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_preview"
        app:layout_constraintStart_toStartOf="@id/image_preview"
        app:layout_constraintEnd_toEndOf="@id/image_preview"/>

    <!-- Crop toolbar -->
    <LinearLayout android:id="@+id/crop_toolbar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" android:gravity="center"
        android:orientation="horizontal" android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel">
        <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/aspect_chips"
                app:singleSelection="true" app:selectionRequired="true" app:singleLine="true"
                android:layout_width="wrap_content" android:layout_height="wrap_content">
                <com.google.android.material.chip.Chip android:id="@+id/aspect_free"
                    style="@style/Widget.Material3.Chip.Filter" android:checked="true" android:text="Free"/>
                <com.google.android.material.chip.Chip android:id="@+id/aspect_1_1"
                    style="@style/Widget.Material3.Chip.Filter" android:text="1:1"/>
                <com.google.android.material.chip.Chip android:id="@+id/aspect_4_3"
                    style="@style/Widget.Material3.Chip.Filter" android:text="4:3"/>
                <com.google.android.material.chip.Chip android:id="@+id/aspect_16_9"
                    style="@style/Widget.Material3.Chip.Filter" android:text="16:9"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <ImageButton android:id="@+id/btn_crop_cancel" style="@style/EditButton"
            android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="@string/cancel"/>
        <ImageButton android:id="@+id/btn_crop_apply" style="@style/EditButton"
            android:src="@android:drawable/ic_input_get" android:contentDescription="@string/apply"/>
    </LinearLayout>

    <!-- Mask toolbar -->
    <LinearLayout android:id="@+id/mask_toolbar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" android:gravity="center"
        android:orientation="horizontal" android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel">
        <com.google.android.material.chip.Chip android:id="@+id/chip_brush_add"
            style="@style/Widget.Material3.Chip.Filter" android:checked="true" android:text="@string/add"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_brush_erase"
            style="@style/Widget.Material3.Chip.Filter" android:text="@string/erase"/>
        <ImageButton android:id="@+id/btn_mask_clear" style="@style/EditButton"
            android:src="@android:drawable/ic_menu_delete" android:contentDescription="@string/clear"/>
        <ImageButton android:id="@+id/btn_mask_done" style="@style/EditButton"
            android:src="@android:drawable/ic_input_get" android:contentDescription="@string/done"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/bottom_panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/rounded_background" android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/btn_undo" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_revert" android:contentDescription="@string/undo"/>
            <ImageButton android:id="@+id/btn_redo" style="@style/EditButton" android:rotation="180"
                android:src="@android:drawable/ic_menu_revert" android:contentDescription="@string/redo"/>
            <ImageButton android:id="@+id/btn_rotate" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_rotate" android:contentDescription="@string/rotate"/>
            <ImageButton android:id="@+id/btn_flip" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_flip" android:contentDescription="@string/flip"/>
            <ImageButton android:id="@+id/btn_crop" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_crop" android:contentDescription="@string/crop"/>
            <ImageButton android:id="@+id/btn_mask" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_edit" android:contentDescription="@string/mask"/>
            <ImageButton android:id="@+id/btn_auto" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_manage" android:contentDescription="@string/auto_enhance"/>
            <ImageButton android:id="@+id/btn_compare" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_view" android:contentDescription="@string/compare"/>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/preset_row" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp"/>
        </HorizontalScrollView>

        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/category_chips"
                app:singleSelection="true" app:selectionRequired="true" app:singleLine="true"
                android:layout_width="wrap_content" android:layout_height="wrap_content">
                <com.google.android.material.chip.Chip android:id="@+id/cat_looks"
                    style="@style/Widget.Material3.Chip.Filter" android:checked="true" android:text="Looks"/>
                <com.google.android.material.chip.Chip android:id="@+id/cat_tones"
                    style="@style/Widget.Material3.Chip.Filter" android:text="Tones"/>
                <com.google.android.material.chip.Chip android:id="@+id/cat_fx"
                    style="@style/Widget.Material3.Chip.Filter" android:text="Effects"/>
                <com.google.android.material.chip.Chip android:id="@+id/cat_art"
                    style="@style/Widget.Material3.Chip.Filter" android:text="Artistic"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/filter_recycler"
            android:layout_width="match_parent" android:layout_height="76dp"
            android:orientation="horizontal" android:requiresFadingEdge="horizontal"/>

        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/chips_row" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp"/>
        </HorizontalScrollView>

        <com.google.android.material.slider.Slider android:id="@+id/adjust_slider"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="-0.5" android:valueTo="0.5" android:stepSize="0.01"
            app:labelBehavior="floating"/>

        <com.google.android.material.slider.Slider android:id="@+id/strength_slider"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="1" android:stepSize="0.01" android:value="1"
            android:contentDescription="@string/filter_strength" app:labelBehavior="floating"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/btn_gallery" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_gallery" android:contentDescription="@string/save"/>
            <ImageButton android:id="@+id/btn_camera" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_camera" android:contentDescription="@string/capture"/>
            <ImageButton android:id="@+id/btn_add_text" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_edit" android:contentDescription="@string/add_text"/>
            <ImageButton android:id="@+id/btn_add_sticker" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_emoticon" android:contentDescription="@string/add_sticker"/>
            <ImageButton android:id="@+id/btn_front" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="@string/front"
                android:visibility="gone"/>
            <ImageButton android:id="@+id/btn_back" style="@style/EditButton" android:rotation="180"
                android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="@string/back"
                android:visibility="gone"/>
            <ImageButton android:id="@+id/btn_delete_overlay" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_delete" android:contentDescription="@string/delete_overlay"
                android:visibility="gone"/>
            <ImageButton android:id="@+id/btn_lut" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_more" android:contentDescription="@string/lut"/>
            <ImageButton android:id="@+id/btn_surprise" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_help" android:contentDescription="@string/surprise"/>
            <ImageButton android:id="@+id/btn_batch" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_share" android:contentDescription="@string/batch"/>
            <ImageButton android:id="@+id/btn_save" style="@style/EditButton"
                android:src="@android:drawable/ic_menu_save" android:contentDescription="@string/save"/>
            <ImageButton android:id="@+id/btn_video" style="@style/EditButton"
                android:src="@android:drawable/ic_media_play" android:contentDescription="@string/video"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/batch_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
